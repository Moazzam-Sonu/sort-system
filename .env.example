# Your Shopify store domain
# Example: your-store.myshopify.com
SHOPIFY_STORE=your-store.myshopify.com

# Admin API access token
# Example: shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_ACCESS_TOKEN=shpat_your_admin_api_access_token_here

# Neon pooled PostgreSQL connection string. Keep this secret out of Git.
DATABASE_URL=postgresql://user:password@your-endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Database-backed session duration.
APP_SESSION_HOURS=12

# Keep localhost for your own computer. Set HOST=0.0.0.0 on your deployment host.
HOST=127.0.0.1
